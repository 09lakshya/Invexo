# JWT Secret key for authentication token hashing
JWT_SECRET=your_jwt_secret_key_here

# Database connection URL (Optional, defaults to SQLite file locally)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/invexo

# SMTP configuration for sending verification emails (OTP)
# (If omitted, OTP will be printed to console for debugging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=your_email@gmail.com

# Resend API alternative configuration (Alternative to SMTP)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM=onboarding@resend.dev
