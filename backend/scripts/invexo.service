[Unit]
Description=Invexo FastAPI Application
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/Invexo/backend
Environment="PATH=/home/ubuntu/Invexo/backend/venv/bin"
# Production settings
Environment="RENDER_DISK_PATH=/home/ubuntu/Invexo/backend/models"
ExecStart=/home/ubuntu/Invexo/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
